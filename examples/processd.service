[Unit]
Description=Processd process manager
Documentation=https://github.com/curruwilla/processd
After=network.target

[Service]
Type=exec
ExecStart=/usr/local/bin/processd serve --config /etc/processd/processd.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Must exceed shutdown_grace (default 30s), otherwise systemd kills the daemon
# in the middle of stopping the processes it supervises.
TimeoutStopSec=45s

# mixed: systemd signals the daemon only, leaving it to terminate the process
# groups it owns in the right order.
KillMode=mixed
KillSignal=SIGTERM

# Each supervised execution costs about five descriptors: two log files and both
# ends of the stdout and stderr pipes. Budget max_processes * 5 plus a couple of
# hundred for the daemon itself; the value below covers roughly 100k concurrent
# executions, far past what a single node will run. The daemon logs a warning at
# startup when this ceiling is lower than max_processes needs.
LimitNOFILE=524288

# The daemon needs privileges to drop them: it starts each process as the user
# the worker declares.
User=root
StateDirectory=processd
LogsDirectory=processd

NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
